# YoinkIt Environment Variables

# Spotify API (Opcional: Para buscar canciones y descargar playlists directamente)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=tu_spotify_client_id
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret

# Twitter / X Proxy (Opcional: Para evadir bloqueos de cuenta/edad en videos de X)
# Instrucciones de configuración en proxy-worker/README.md
EXPO_PUBLIC_X_PROXY_URL=https://tu-worker.usuario.workers.dev
EXPO_PUBLIC_X_PROXY_KEY=tu_api_key_secreta
